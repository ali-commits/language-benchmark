{
  "uid": "language-benchmark",
  "title": "Language Benchmark \u2014 live and history",
  "schemaVersion": 39,
  "version": 2,
  "refresh": "5s",
  "timezone": "browser",
  "time": {
    "from": "now-1h",
    "to": "now"
  },
  "templating": {
    "list": [
      {
        "name": "cell",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "benchmark-prometheus"
        },
        "query": "label_values(k6_operations_attempted_total, cell)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      },
      {
        "name": "trial",
        "type": "query",
        "datasource": {
          "type": "prometheus",
          "uid": "benchmark-prometheus"
        },
        "query": "label_values(k6_operations_attempted_total, trial)",
        "includeAll": true,
        "allValue": ".*",
        "multi": true,
        "refresh": 1
      },
      {
        "name": "threshold",
        "type": "custom",
        "query": "0.90,0.95,0.99,0.999",
        "current": {
          "text": "0.90",
          "value": "0.90"
        },
        "includeAll": false,
        "multi": false,
        "allowCustomValue": true,
        "label": "Operation success threshold"
      }
    ]
  },
  "panels": [
    {
      "id": 1,
      "title": "Live successful operations/s",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell,operation) (rate(k6_operations_succeeded_total{cell=~\"$cell\",trial=~\"$trial\"}[30s]))",
          "legendFormat": "{{cell}} {{operation}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "title": "Latency p50 / p95 / p99 (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_operation_duration_p95{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{operation}} {{job}}"
        },
        {
          "refId": "B",
          "expr": "k6_operation_duration_p50{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "p50 {{operation}}"
        },
        {
          "refId": "C",
          "expr": "k6_operation_duration_p99{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "p99 {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "title": "Failed operations",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell) (k6_operations_failed_total{cell=~\"$cell\",trial=~\"$trial\"})",
          "legendFormat": "{{cell}} {{operation}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "title": "Dropped arrivals",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 8,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell) (k6_dropped_iterations_total{cell=~\"$cell\",trial=~\"$trial\"})",
          "legendFormat": "{{cell}} {{operation}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "title": "Host CPU utilization",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by (job) (rate(node_cpu_seconds_total{mode=\"idle\"}[1m])))",
          "legendFormat": "{{cell}} {{operation}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 6,
      "title": "Host available memory",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 16,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "node_memory_MemAvailable_bytes",
          "legendFormat": "{{cell}} {{operation}} {{job}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "bytes"
        },
        "overrides": []
      }
    },
    {
      "id": 7,
      "title": "Historical successful throughput by offered rate",
      "type": "table",
      "gridPos": {
        "x": 0,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_successful_ops_per_second{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{operation}} {{job}}",
          "instant": true,
          "format": "table"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ops"
        },
        "overrides": []
      }
    },
    {
      "id": 8,
      "title": "Historical p95 latency and validity",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 24,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_latency_p95_ms{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{operation}} {{job}}"
        },
        {
          "refId": "B",
          "expr": "benchmark_trial_qualified{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "validity: 1 pass, 0 fail, -1 unknown"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 30,
      "title": "Concurrent active users",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_journey_active_users{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{trial}}"
        }
      ]
    },
    {
      "id": 31,
      "title": "Authenticated unique users",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 40,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell,trial) (k6_users_authenticated_total{cell=~\"$cell\",trial=~\"$trial\"})",
          "legendFormat": "{{cell}} {{trial}}"
        }
      ]
    },
    {
      "id": 32,
      "title": "User response timeouts",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum by (cell,trial) (k6_journey_timeouts_total{cell=~\"$cell\",trial=~\"$trial\"})",
          "legendFormat": "{{cell}} {{trial}}"
        }
      ]
    },
    {
      "id": 33,
      "title": "Historical concurrent-user capacity probes",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 48,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_target_users{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{trial}}"
        }
      ]
    },
    {
      "id": 20,
      "title": "RDS CPU",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "benchmark-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Metrics",
          "namespace": "AWS/RDS",
          "metricName": "CPUUtilization",
          "statistic": "Average",
          "dimensions": {
            "DBInstanceIdentifier": [
              "language-benchmark"
            ]
          },
          "region": "ap-southeast-1",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 21,
      "title": "RDS connections",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 32,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "cloudwatch",
        "uid": "benchmark-cloudwatch"
      },
      "targets": [
        {
          "refId": "A",
          "queryMode": "Metrics",
          "namespace": "AWS/RDS",
          "metricName": "DatabaseConnections",
          "statistic": "Average",
          "dimensions": {
            "DBInstanceIdentifier": [
              "language-benchmark"
            ]
          },
          "region": "ap-southeast-1",
          "period": "60",
          "matchExact": true,
          "metricQueryType": 0,
          "metricEditorMode": 0
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 50,
      "title": "Historical highest observed passing users (not exact capacity)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "max by (campaign,cell,profile,methodology) ((benchmark_target_users{cell=~\"$cell\",trial=~\"$trial\"} and on (cell,trial,campaign,profile,experiment_type,methodology,authentication_policy,target_users,offered_rate,workload) (benchmark_technical_valid{cell=~\"$cell\",trial=~\"$trial\"} == 1) and on (cell,trial,campaign,profile,experiment_type,methodology,authentication_policy,target_users,offered_rate,workload) (benchmark_authentication_gate_satisfied{cell=~\"$cell\",trial=~\"$trial\"} == 1)) and on (cell,trial,campaign,profile,experiment_type,methodology,authentication_policy,target_users,offered_rate,workload) (benchmark_operation_success_fraction{cell=~\"$cell\",trial=~\"$trial\"} >= $threshold))",
          "legendFormat": "{{cell}} {{campaign}} {{profile}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 51,
      "title": "Historical lowest observed failing users (check contradictions in CLI)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 56,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "min by (campaign,cell,profile,methodology) (benchmark_target_users{cell=~\"$cell\",trial=~\"$trial\"} and on (cell,trial,campaign,profile,experiment_type,methodology,authentication_policy,target_users,offered_rate,workload) (benchmark_technical_valid{cell=~\"$cell\",trial=~\"$trial\"} == 1) and on (cell,trial,campaign,profile,experiment_type,methodology,authentication_policy,target_users,offered_rate,workload) ((benchmark_operation_success_fraction{cell=~\"$cell\",trial=~\"$trial\"} < $threshold) or (benchmark_authentication_gate_satisfied{cell=~\"$cell\",trial=~\"$trial\"} == 0)))",
          "legendFormat": "{{cell}} {{campaign}} {{profile}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short"
        },
        "overrides": []
      }
    },
    {
      "id": 52,
      "title": "Historical mean latency (failed replies included)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_latency_mean_ms{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{campaign}} {{profile}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 53,
      "title": "Historical p99.9 latency (raw trial samples)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 64,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_latency_p999_ms{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{campaign}} {{profile}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      }
    },
    {
      "id": 54,
      "title": "Backend container mean CPU: 100% = 2 vCPUs",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_backend_cpu_percent_mean{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{campaign}} {{profile}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent"
        },
        "overrides": []
      }
    },
    {
      "id": 55,
      "title": "Backend sampled working set (MiB)",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 72,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_backend_memory_working_set_mib_peak{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{campaign}} {{profile}} {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "mebibytes"
        },
        "overrides": []
      }
    },
    {
      "id": 56,
      "title": "Live operation mean / p99.9 latency (seconds)",
      "type": "timeseries",
      "gridPos": {
        "x": 0,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "k6_operation_duration_avg{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{campaign}} {{profile}} {{operation}}"
        },
        {
          "refId": "B",
          "expr": "k6_operation_duration_p999{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "p99.9 {{operation}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "s"
        },
        "overrides": []
      }
    },
    {
      "id": 57,
      "title": "Operation success fraction and chosen threshold",
      "type": "timeseries",
      "gridPos": {
        "x": 12,
        "y": 80,
        "w": 12,
        "h": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "benchmark-prometheus"
      },
      "targets": [
        {
          "refId": "A",
          "expr": "benchmark_operation_success_fraction{cell=~\"$cell\",trial=~\"$trial\"}",
          "legendFormat": "{{cell}} {{campaign}} {{profile}} {{operation}}"
        },
        {
          "refId": "B",
          "expr": "$threshold",
          "legendFormat": "chosen target"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit"
        },
        "overrides": []
      }
    }
  ],
  "tags": [
    "benchmark",
    "languages"
  ],
  "description": "Compare equal workloads/rates/fixtures. Never average percentiles across trials. Saved raw artifacts define final qualification. Threshold comparisons show observed bounds only; invalid telemetry remains excluded. Authentication uses its saved separate gate. Docker CPU100% means both allocatedCPUs; memory is sampled working set."
}