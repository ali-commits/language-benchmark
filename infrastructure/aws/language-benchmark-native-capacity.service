[Unit]
Description=Native language benchmark guarded capacity controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rocky
WorkingDirectory=/home/rocky/language-benchmark
ExecStart=/bin/bash -lc 'source artifacts/aws/monitor.env; export PATH=/home/rocky/.local/bin:$PATH; exec uv run -m bench.native_campaign --config artifacts/aws/native-capacity.json --output artifacts/results/native-capacity >> artifacts/aws/native-capacity.log 2>&1'
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=600
Restart=no
