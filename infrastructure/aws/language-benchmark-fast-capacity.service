[Unit]
Description=Mixed-language benchmark fast 90 percent capacity controller
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rocky
WorkingDirectory=/home/rocky/language-benchmark
ExecStart=/bin/bash -lc 'source artifacts/aws/monitor.env; export PATH=/home/rocky/.local/bin:$PATH; exec uv run -m bench.capacity_campaign --config artifacts/aws/fast-capacity.json --output artifacts/results/capacity90-20261006 >> artifacts/aws/fast-capacity.log 2>&1'
KillSignal=SIGINT
KillMode=control-group
TimeoutStopSec=600
Restart=no
