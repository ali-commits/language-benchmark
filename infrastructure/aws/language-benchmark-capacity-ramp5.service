[Unit]
Description=Mixed-language 90 percent capacity with five minute ramp and two minute steady
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=rocky
WorkingDirectory=/home/rocky/language-benchmark
ExecStartPre=/bin/bash -lc 'export PATH=/home/rocky/.local/bin:$PATH; exec uv sync --frozen'
ExecStart=/bin/bash -lc 'source artifacts/aws/monitor.env; export PYTHONPATH=/home/rocky/language-benchmark/tools; exec /home/rocky/language-benchmark/.venv/bin/python -m bench.capacity_campaign --config artifacts/aws/capacity-ramp5.json --output artifacts/results/capacity90-ramp5-20261006 >> artifacts/aws/capacity-ramp5.log 2>&1'
KillSignal=SIGINT
KillMode=mixed
TimeoutStopSec=600
Restart=no
