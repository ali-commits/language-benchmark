# Copy to a PRIVATE file; generate JWT_SECRET with `python3 -c "import secrets; print(secrets.token_hex(32))"`.
JWT_SECRET=
DB_PASSWORD=local-benchmark-only
DATABASE_URL=postgresql://benchmark:local-benchmark-only@127.0.0.1:55433/language_benchmark
# AWS: sslmode=verify-full&sslrootcert=/certs/rds-ca.pem
RDS_CA_FILE=/absolute/path/to/rds-ca.pem
BACKEND_IMAGE=lb-python-baseline:3.10.22
BIND_IP=127.0.0.1
SEED_PASSWORD=
SEED_HASH_WORKERS=4
