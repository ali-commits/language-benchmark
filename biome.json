{
  "files": {
    "includes": [
      "benchmarks/k6/**/*.js",
      "benchmarks/k6/**/*.d.ts",
      "tools/bench/templates/**/*.d.ts",
      "tools/**/*.js",
      "tools/bench/templates/**/*.json",
      "examples/**/*.js",
      "examples/**/*.json",
      "benchmarks/*.json",
      "package.json",
      "biome.json",
      "tsconfig.json"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "javascript": {
    "globals": ["__ENV", "__VU", "__ITER", "open"],
    "formatter": {
      "quoteStyle": "single"
    }
  }
}
