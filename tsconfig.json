{
  "compilerOptions": {
    "allowJs": true,
    "checkJs": true,
    "strict": true,
    "noEmit": true,
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "types": ["k6"],
    "lib": ["ES2022"]
  },
  "include": [
    "benchmarks/k6/**/*.js",
    "tools/**/*.js",
    "examples/**/*.js",
    "benchmarks/k6/**/*.d.ts"
  ],
  "exclude": ["backends", "node_modules", "artifacts", "output", "tmp", ".superpowers"]
}
